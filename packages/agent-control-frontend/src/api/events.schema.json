{
  "$defs": {
    "EventEnvelope": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "bot_id": {
          "minLength": 1,
          "title": "Bot Id",
          "type": "string"
        },
        "data": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data",
          "type": "object"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "generation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation"
        },
        "occurred_at": {
          "title": "Occurred At",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Session Id"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "workspace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "seq",
        "bot_id",
        "session_id",
        "run_id",
        "occurred_at",
        "type",
        "data"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "JsonValue": {},
    "Message": {
      "additionalProperties": true,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Occurred At"
        },
        "ordinal": {
          "title": "Ordinal",
          "type": "integer"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "role",
        "content",
        "seq",
        "ordinal",
        "occurred_at"
      ],
      "title": "Message",
      "type": "object"
    },
    "ReadyFrame": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "ready",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "seq"
      ],
      "title": "ReadyFrame",
      "type": "object"
    },
    "SnapshotData": {
      "additionalProperties": true,
      "properties": {
        "bot_id": {
          "minLength": 1,
          "title": "Bot Id",
          "type": "string"
        },
        "computer": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Computer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EventEnvelope"
          },
          "title": "Events",
          "type": "array"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "title": "Messages",
          "type": "array"
        },
        "messages_before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Messages Before"
        },
        "observations_truncated": {
          "title": "Observations Truncated",
          "type": "boolean"
        },
        "pending_approvals": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Pending Approvals",
          "type": "array"
        },
        "run": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "snapshot_seq": {
          "minimum": 0,
          "title": "Snapshot Seq",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "bot_id",
        "snapshot_seq",
        "computer",
        "run",
        "messages",
        "messages_before",
        "events",
        "pending_approvals",
        "observations_truncated"
      ],
      "title": "SnapshotData",
      "type": "object"
    },
    "SnapshotFrame": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/SnapshotData"
        },
        "type": {
          "const": "snapshot",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "title": "SnapshotFrame",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/EventEnvelope"
    },
    {
      "discriminator": {
        "mapping": {
          "ready": "#/$defs/ReadyFrame",
          "snapshot": "#/$defs/SnapshotFrame"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SnapshotFrame"
        },
        {
          "$ref": "#/$defs/ReadyFrame"
        }
      ]
    }
  ],
  "title": "WireFrame"
}
