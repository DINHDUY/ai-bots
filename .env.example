OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
SANDBOX_IMAGE=agentbot-sandbox
SESSION_DATA_DIR=data/sessions
SESSION_IDLE_SECONDS=900
APPROVAL_TIMEOUT_SECONDS=120
RUN_TIMEOUT_SECONDS=900
# Atomic capacity limits; retained/failed/hibernated computers count until closed.
CONTROL_MAX_RUNS=32
CONTROL_MAX_RUNS_PER_OWNER=8
CONTROL_MAX_COMPUTERS=64
CONTROL_MAX_COMPUTERS_PER_OWNER=16
EVENT_RETENTION_DAYS=30
# Combined retained screenshot/artifact budget per workspace (256 MiB default).
# Set 2147483648 for a 2 GiB ceiling, then configure screenshots in Workspace settings > Storage.
WORKSPACE_BLOB_LIMIT_BYTES=268435456
HEALTH_POLL_SECONDS=10
# Disable B3-B11 admission/routes for staged rollout; existing state is preserved.
CONTROL_WORKSPACE_FEATURES=1
# Workspace bot channels; individual workspaces start with collaboration off.
CONTROL_WORKSPACE_CHANNELS=1
# Optional operator-owned JSON file. Leave blank for Docker/Windows only.
CONTROL_COMPUTE_PROFILES=
MAX_AGENT_STEPS=25
MAX_TOOL_TURNS=20
# Session-signing secret. Without an explicit keyring, also derives an encryption key.
# See docs/021-foundation-operations.md before rotating either key source.
AGENTBOT_SECRET=
# Optional protected JSON keyring file, separate from the session-signing secret.
AGENTBOT_KEYRING_FILE=
CONTROL_DB=data/control.sqlite
ALLOW_REGISTER=1
COOKIE_SECURE=
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://127.0.0.1:5173
