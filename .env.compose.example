# Compose-specific environment variables.
# Copy to .env.compose and fill in values for your platform.
# The app's own secrets/keys stay in .env (from .env.example).

# ---------------------------------------------------------------------------
# Podman socket path
# ---------------------------------------------------------------------------
# The backend and gateway mount this socket to spawn sandbox containers.
# Run `scripts/podman-setup.sh` to auto-detect and write PODMAN_SOCK here.
#
# Linux rootless (default):
#   PODMAN_SOCK=/run/user/1000/podman/podman.sock
#
# Linux rootful:
#   PODMAN_SOCK=/run/podman/podman.sock
#
# macOS (Podman Machine):
#   Run: podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}'
#   PODMAN_SOCK=/var/folders/.../podman.sock
#
# Windows (WSL2 socket forwarded to host path):
#   PODMAN_SOCK=//./pipe/podman-machine-default
#   Also set DOCKER_HOST=npipe:////./pipe/podman-machine-default in .env
PODMAN_SOCK=/run/user/1000/podman/podman.sock

# ---------------------------------------------------------------------------
# Production overrides (compose.prd.yml)
# ---------------------------------------------------------------------------
# Host port for the nginx frontend container (default: 80)
FRONTEND_PORT=80

# CORS origin for the backend in production (should match your public hostname)
CORS_ORIGINS=http://localhost
