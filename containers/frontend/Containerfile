# ---- Build stage ----
FROM node:24-alpine AS builder

WORKDIR /app

COPY packages/agent-control-frontend/package*.json packages/agent-control-frontend/.npmrc ./
RUN npm ci

COPY packages/agent-control-frontend/ .

# VITE_API_BASE is intentionally empty: nginx proxies /api/ and /ws on the same origin
ARG VITE_API_BASE=""
ENV VITE_API_BASE=${VITE_API_BASE}

RUN npm run build

# ---- Serve stage ----
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY containers/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
