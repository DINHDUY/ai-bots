FROM node:24-alpine

WORKDIR /app

COPY packages/agent-control-frontend/package*.json packages/agent-control-frontend/.npmrc ./
RUN npm ci

# Source files are volume-mounted at runtime for hot reload;
# this copy is a fallback so the image is self-contained.
COPY packages/agent-control-frontend/ .

# Browser connects directly to backend on the host port (8001)
ENV VITE_API_BASE=http://127.0.0.1:8001

EXPOSE 5174

# --host 0.0.0.0 makes Vite reachable from outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5174"]
