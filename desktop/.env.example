# Agent Control Desktop Environment Configuration
# Copy this file to .env and customize as needed.

# ─────────────────────────────────────────────────────────────
# Desktop App Settings
# ─────────────────────────────────────────────────────────────

# Which compose file to use for desktop stack launch
# Options: compose.dev.yml (development) or compose.prd.yml (production)
COMPOSE_FILE=compose.dev.yml

# Project name used by Podman Compose
COMPOSE_PROJECT_NAME=agentbot-desktop

# Container runtime (podman or docker)
CONTAINER_RUNTIME=podman

# ─────────────────────────────────────────────────────────────
# Podman Configuration
# ─────────────────────────────────────────────────────────────

# Podman socket path (auto-detected if not set)
# Linux rootless: /run/user/1000/podman/podman.sock
# Linux rootful: /run/podman/podman.sock
# macOS: /var/folders/.../podman.sock (from podman machine inspect)
# PODMAN_SOCK=/run/user/1000/podman/podman.sock

# Auto-start Podman Machine on macOS
PODMAN_AUTO_START_MACHINE=true

# ─────────────────────────────────────────────────────────────
# Stack Behavior
# ─────────────────────────────────────────────────────────────

# Keep volumes when the app closes (do not run -v flag on compose down)
PRESERVE_VOLUMES=true

# Health check timeout (seconds)
HEALTH_CHECK_TIMEOUT=120

# Show service logs during startup
SHOW_STARTUP_LOGS=false

# ─────────────────────────────────────────────────────────────
# Application Secrets
# ─────────────────────────────────────────────────────────────
# These are passed through to the container stack's .env file.
# Copy values from ../. env (or the values set during main project setup).

AGENTBOT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
